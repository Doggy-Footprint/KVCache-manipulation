{
  "hooks": [
    {
      "event": "SessionEnd",
      "command": "python3 \"{root}/.harness/bin/spec_lifecycle.py\" session"
    },
    {
      "event": "SessionStart",
      "matcher": "clear",
      "targets": ["codex"],
      "_note": "/clear in codex trigger this",
      "command": "python3 \"{root}/.harness/bin/spec_lifecycle.py\" session"
    },
    {
      "event": "SessionStart",
      "command": "python3 \"{root}/.harness/hooks/session_lock.py\""
    },
    {
      "event": "SessionEnd",
      "command": "python3 \"{root}/.harness/hooks/session_lock.py\""
    },
    {
      "event": "SubagentStart",
      "command": "python3 \"{root}/.harness/hooks/spec_gate.py\""
    },
    {
      "event": "SubagentStop",
      "command": "python3 \"{root}/.harness/hooks/spec_gate.py\""
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "python3 \"{root}/.harness/hooks/spec_gate.py\""
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash|Read|Grep|Glob|LS|Agent|Task",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/telemetry_hook.py\""
    },
    {
      "event": "PostToolUse",
      "matcher": "Write|Edit|MultiEdit",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/doc_commit.py\""
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/pr_message_nudge.py\""
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|Write|Edit|NotebookEdit|Read|Grep|Glob|LS",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/telemetry_hook.py\""
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|apply_patch",
      "targets": ["codex"],
      "command": "python3 \"{root}/.harness/hooks/telemetry_hook.py\""
    },
    {
      "event": "SessionEnd",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/telemetry_hook.py\""
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "Bash",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/telemetry_hook.py\""
    },
    {
      "event": "SessionStart",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/progress_hook.py\""
    },
    {
      "event": "UserPromptSubmit",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/progress_hook.py\""
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/progress_hook.py\""
    },
    {
      "event": "PostToolUse",
      "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/progress_hook.py\""
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "Bash",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/progress_hook.py\""
    },
    {
      "event": "PreCompact",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/progress_hook.py\""
    },
    {
      "event": "Stop",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/progress_hook.py\""
    },
    {
      "event": "SessionEnd",
      "targets": ["claude"],
      "command": "python3 \"{root}/.harness/hooks/progress_hook.py\""
    }
  ]
}
